                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Walllpaper manufacturing is a delicate, traditional process. Please allow some time to thoroughly inspect all rolls prior to hanging or booking  a decorator.</Value>
                      <Style>
                        <FontSize>8pt</FontSize>
                      </Style>
                    </TextRun>
