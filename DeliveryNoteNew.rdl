                  <Style />
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Please note, wallcoverings do not necessarily come off the roll directional. Some design may need to be cut and then hung in the desired direction.</Value>
                      <Style>
                        <FontSize>8pt</FontSize>
                      </Style>
                    </TextRun>
